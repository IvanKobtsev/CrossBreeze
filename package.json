{
  "name": "crossbreeze",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build:server": "node scripts/build-server.mjs",
    "test": "npm run build:server && node --test server/test/*.test.mjs",
    "bundle": "npm run build:server && node scripts/bundle-native.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs"
  },
  "dependencies": {
    "@cross-css/native": "0.3.3",
    "chokidar": "4.0.3",
    "css-tree": "3.2.1",
    "jsonc-parser": "3.3.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0",
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
