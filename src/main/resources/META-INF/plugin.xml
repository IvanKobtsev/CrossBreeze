<idea-plugin>
  <id>dev.crossbreeze.jetbrains</id>
  <name>CrossBreeze</name>
  <vendor url="https://github.com/IvanKobtsev/CrossBreeze">Ivan Kobtsev</vendor>
  <description><![CDATA[
    <p>XCSS language support for WebStorm: diagnostics, definition navigation,
    references, hover, semantic highlighting, and source formatting. Includes lexical highlighting
    while the language server starts. Uses the project's configured local Node.js runtime.</p>
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.ultimate</depends>
  <depends>com.intellij.modules.lsp</depends>
  <depends>JavaScript</depends>
  <depends>NodeJS</depends>
  <extensions defaultExtensionNs="com.intellij">
    <fileType name="XCSS" language="XCSS" extensions="xcss" implementationClass="dev.crossbreeze.jetbrains.XcssFileType" fieldName="INSTANCE"/>
    <editorNotificationProvider implementation="dev.crossbreeze.jetbrains.XcssTypescriptSetupNotification"/>
    <postStartupActivity implementation="dev.crossbreeze.jetbrains.ViteSetupStartup"/>
    <colorProvider implementation="dev.crossbreeze.jetbrains.XcssColorProvider"/>
    <lang.parserDefinition language="XCSS" implementationClass="dev.crossbreeze.jetbrains.XcssParserDefinition"/>
    <lang.commenter language="XCSS" implementationClass="dev.crossbreeze.jetbrains.XcssCommenter"/>
    <lang.braceMatcher language="XCSS" implementationClass="dev.crossbreeze.jetbrains.XcssBraceMatcher"/>
    <lang.quoteHandler fileType="XCSS" implementationClass="dev.crossbreeze.jetbrains.XcssQuoteHandler"/>
    <enterHandlerDelegate implementation="dev.crossbreeze.jetbrains.XcssEnterHandler"/>
    <backspaceHandlerDelegate implementation="dev.crossbreeze.jetbrains.XcssBackspaceHandler" order="first"/>
    <lang.syntaxHighlighterFactory language="XCSS" implementationClass="dev.crossbreeze.jetbrains.XcssSyntaxHighlighterFactory"/>
    <colorSettingsPage implementation="dev.crossbreeze.jetbrains.XcssColorSettingsPage"/>
    <langCodeStyleSettingsProvider implementation="dev.crossbreeze.jetbrains.XcssCodeStyleProvider"/>
    <platform.lsp.integrationProvider implementation="dev.crossbreeze.jetbrains.CrossBreezeLspIntegrationProvider"/>
    <gotoDeclarationHandler implementation="dev.crossbreeze.jetbrains.XcssNavigationHandler" order="first"/>
    <usageSearcher implementation="dev.crossbreeze.jetbrains.XcssNavigationUsageSearcher"/>
    <projectConfigurable id="dev.crossbreeze.settings" displayName="CrossBreeze" instance="dev.crossbreeze.jetbrains.CrossBreezeConfigurable"/>
    <notificationGroup id="CrossBreeze" displayType="BALLOON"/>
    <statusBarWidgetFactory id="CrossBreeze" implementation="dev.crossbreeze.jetbrains.CrossBreezeStatusWidgetFactory"/>
  </extensions>
  <actions>
    <action id="CrossBreeze.Restart" class="dev.crossbreeze.jetbrains.CrossBreezeRestartAction" text="Restart CrossBreeze Language Server">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
